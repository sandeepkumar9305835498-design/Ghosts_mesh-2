<?xml version="1.0" encoding="utf-8"?>
<!--
  Single-screen shell: MainActivity pads "root" with the system-bar insets and
  the WebView fills everything that is left, so the web app is never drawn
  underneath the status bar or the navigation bar.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gm_bg">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gm_bg" />

</FrameLayout>
