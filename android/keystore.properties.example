# Release signing credentials for Ghost Mesh.
#
# Copy this file to keystore.properties and fill in your own values:
#     cp android/keystore.properties.example android/keystore.properties
#
# keystore.properties is gitignored — never commit it, and never commit the
# .jks/.keystore file it points to. Back both up somewhere safe: if you lose the
# upload key you cannot publish updates to an app already on the Play Store
# (unless you use Play Console's upload-key reset).
#
# storeFile may be an absolute path, or relative to the android/ folder.
# Keep the keystore OUTSIDE this repository, e.g. ~/keystores/ghostmesh-upload.jks
#
# Alternatively, leave this file absent and export the equivalent environment
# variables (GHOSTMESH_STORE_FILE, GHOSTMESH_STORE_PASSWORD, GHOSTMESH_KEY_ALIAS,
# GHOSTMESH_KEY_PASSWORD) — which is what CI should use.

storeFile=/absolute/path/to/ghostmesh-upload.jks
storePassword=your-keystore-password
keyAlias=ghostmesh-upload
keyPassword=your-key-password
